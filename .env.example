NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/securechat?retryWrites=true&w=majority
MONGO_POOL_SIZE=50
# Optional: public resolvers for mongodb+srv when local DNS cannot resolve SRV records
DNS_SERVERS=8.8.8.8,1.1.1.1

REDIS_URL=redis://127.0.0.1:6379

# 32+ random chars each: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

CORS_ORIGINS=*
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

MESSAGE_EDIT_WINDOW_MIN=15
DELETE_FOR_EVERYONE_WINDOW_MIN=60

OTP_DEV_MODE=true
RUN_WORKERS=true
CLUSTER_WORKERS=0
LOG_LEVEL=info

# Protected files: AES-256-GCM key (64 hex chars) and secret for short-lived viewer tokens
SECURE_UPLOAD_DIR=secure_uploads
FILE_ENCRYPTION_KEY=
FILE_TOKEN_SECRET=
# Public web app origin used in invite links
APP_URL=http://localhost:8080
